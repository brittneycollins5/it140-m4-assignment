w# IT 140 Module Four Assignment
# Higher/Lower Game Pseudocode Template
#
# Complete the TODO prompts below with your own pseudocode.
# Keep this file in .pseudo format for submission.
#
# Use clear indentation to show decisions and repeated behavior.
# Your finished pseudocode should address every requirement in the
# current Module Four Assignment Guidelines and Rubric.

START hilow_game

    # Establish a valid guessing range.
    OUTPUT "Enter the lower bound:"
    INPUT lowerBound
OUTPUT "Enter the upper bound:"
INPUT upperBound
WHILE lowerBound >= upperBound
OUTPUT "Lower bound must be less than upper bound."
OUTPUT "Enter the lower bound:"
INPUT lowerBound
OUTPUT "Enter the upper bound:"
INPUT upperBound
END WHILE

    # Establish the number the player is trying to guess.
    SET targetNumber = RANDOM number between lowerBound and upperBound

    # Play the game.
    OUTPUT "Enter a guess between the lower and upper bounds:"
    INPUT guess
        
        WHILE guess < lowerBound OR guess > upperBound
            OUTPUT "Guess must be between the lower and upper bounds."
            OUTPUT "Enter another guess:"
            INPUT guess
END WHILE

WHILE guess != targetNumber
    IF guess < targetNumber THEN
        OUTPUT "Too low!"
    ELSE IF guess > targetNumber THEN
         OUTPUT "Too high!"
    END IF

OUTPUT "Enter another guess:"
INPUT guess

WHILE guess < lowerBound OR guess > upperBound
    OUTPUT "Guess must be in range."
    OUTPUT "Enter another guess:"
    INPUT guess
END WHILE
END WHILE

OUTPUT "You guessed the correct number!"

END hilow_game
